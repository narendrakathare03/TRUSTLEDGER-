# Use your existing PostgreSQL server and database named postgres.
# Replace YOUR_WINDOWS_POSTGRES_PASSWORD with the password set during installation.
DATABASE_URL=postgresql://postgres:YOUR_WINDOWS_POSTGRES_PASSWORD@localhost:5432/postgres
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
# Embedding model returns 384 dimensions and is downloaded on first use.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.76
